{
  "name": "nami",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "signing:setup": "python tools/local-app.py setup",
    "build:app": "python tools/local-app.py build",
    "install:app": "python tools/local-app.py install",
    "test:signing": "python tools/dev.py signing",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tauri": "tauri",
    "check:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml && cargo test --manifest-path src-tauri/Cargo.toml --all-features",
    "test:ui": "python tools/dev.py ui",
    "test:smoke": "python tools/dev.py smoke",
    "test:ui:native": "python tools/dev.py native",
    "verify:ui": "npm run test:all",
    "test:ui:visible": "python tools/dev.py native-visible",
    "test:python": "python tools/dev.py unit",
    "setup:python": "python tools/dev.py setup",
    "test:tools": "python tools/dev.py tools",
    "verify:portable": "npm test && npm run test:python && npm run build && npm run check:rust && npm run test:rust",
    "test:functional": "python tools/dev.py functional",
    "test:dfx:performance": "python tools/dev.py dfx-performance",
    "test:dfx:reliability": "python tools/dev.py dfx-reliability",
    "test:dfx:security": "python tools/dev.py dfx-security",
    "test:dfx:diagnostics": "python tools/dev.py dfx-diagnostics",
    "test:dfx:compatibility": "python tools/dev.py dfx-compatibility",
    "test:all": "python tools/dev.py all"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "lucide-react": "^1.72.0",
    "motion": "12.43.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^31.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aihaipeng/nami.git"
  }
}
